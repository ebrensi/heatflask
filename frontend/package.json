{
  "name": "heatflask-frontend",
  "version": "1.0.0",
  "author": "Efrem Rensi",
  "description": "Animated Movement Data Visualization for Strava Tracks",
  "license": "ISC",
  "homepage": "https://github.com/ebrensi/heatflask",
  "repository": {
    "type": "git",
    "url": "https://github.com/ebrensi/heatflask"
  },
  "scripts": {
    "parcel-watch": "parcel watch --log-level info 'src/webpages/**/!(tab.*).html'",
    "parcel-build": "parcel build 'src/webpages/**/!(tab.*).html'",
    "build": "npm run clean; npm run parcel-build",
    "watch": "npm run parcel-watch",
    "clean": "rm -rf dist/* .parcel-cache/* dev-docs/*; cp src/dist/* dist/",
    "format": "prettier --write src/",
    "doc": "pdoc -o ./dist/docs/backend/ ../backend/heatflask & typedoc"
  },
  "workspaces": [
    "src/*"
  ],
  "context": "browser",
  "dependencies": {
    "@msgpack/msgpack": "^2.7.1",
    "@types/google.analytics": "^0.0.42",
    "downloadjs": "^1.4.7",
    "gif.js": "github:ebrensi/gif.js#wasm-dev",
    "knob": "github:ebrensi/knob",
    "latlon-geohash": "^2.0.0",
    "leaflet": "^1.7.1",
    "leaflet-areaselect": "github:ebrensi/leaflet-areaselect",
    "leaflet-control-window": "^1.0.0",
    "leaflet-easybutton": "^2.4.0",
    "leaflet-image": "^0.4.0",
    "leaflet-providers": "^1.13.0",
    "mediabunny": "^1.56.1",
    "sidebar-v2": "^0.4.0"
  },
  "browserslist": [
    "> 0.75%, last 2 versions, not dead"
  ],
  "devDependencies": {
    "@parcel/resolver-glob": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@types/latlon-geohash": "^2.0.0",
    "@types/leaflet": "^1.7.7",
    "@types/leaflet-providers": "^1.2.1",
    "@types/node": "^17.0.25",
    "@typescript-eslint/eslint-plugin": "^5.8.0",
    "@typescript-eslint/parser": "^5.8.0",
    "eslint": "^8.5.0",
    "eslint-config-prettier": "^8.3.0",
    "onchange": "^7.1.0",
    "parcel": "^2.16.4",
    "prettier": "^2.5.1",
    "process": "^0.11.10",
    "typedoc": "^0.22.15",
    "typescript": "~5.9"
  },
  "prettier": {
    "semi": false
  }
}
