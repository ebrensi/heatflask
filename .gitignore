# Sublime-Text files
*.sublime-project
*.sublime-workspace

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Distribution / packaging
.Python
env/
build/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg


# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

#Flask stuff
instance/

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# =========================
# Operating System Files
# =========================

# OSX
# =========================

.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
# =========================

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

################
# My Additions #
################
*.log
log.txt
.hidden
.fuse*


# .venv/ is the directory contanining the Python virtual
#  environment for the backend server
backend/.venv

# Ignore node_modules both as a directory, and as a symbolic link
frontend/node_modules

# Ignore ParcelJS caches
frontend/.parcel-cache

# Local datastore and logs, created by heatflask-setup /
# heatflask-start-services. Purely local runtime state.
.data/

# For Development
frontend/dev-docs.md

# Local credentials: Strava client secret and friends. backend/.env.tmp is the
# committed template; the filled-in file must never be committed, under either
# name (.dev-install-backend calls it `activate`).
backend/activate
backend/.env
.env

# frontend/dist has to exist for the app to run, but it is built on the
# server, so the build output does not belong in the repo. Ignore the
# generated files and keep the two hand-written ones that get copied in.
#
# This was a commented-out `frontend/dist` and nothing else, which left every
# build artifact showing as untracked -- so a `git add -A` would sweep several
# MB of hashed bundles and source maps into a commit.
frontend/dist/*
!frontend/dist/README.md
!frontend/dist/robots.txt
