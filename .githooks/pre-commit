#!/usr/bin/env sh

# This is a pre-commit hook that auto-formats any commited source files
#  using Prettier for frontend (.js, .ts, .html) files
#  and Ruff for backend (.py) files
#
# heatflask-setup installs it, by pointing git's core.hooksPath at .githooks.
# A formatter that is not installed yet is skipped rather than failing the
# commit: Prettier arrives with frontend/node_modules, Ruff with the dev
# shell, so committing from outside `nix develop` still works.

PRETTIER=./frontend/node_modules/.bin/prettier

# Files to run Prettier on
PRETTIER_FILES=$(git diff --cached --name-only --diff-filter=ACMR "*.js" "*.ts" "*.html" "*.css" "*.jsx" | sed 's| |\\ |g')

# Files to run Ruff on
RUFF_FILES=$(git diff --cached --name-only --diff-filter=ACMR "*.py")

if [ -n "$PRETTIER_FILES" ]; then
    if [ -x "$PRETTIER" ]; then
        # Prettify selected files
        echo "$PRETTIER_FILES" | xargs "$PRETTIER" --write

        # Add back the modified/prettified files to staging
        echo "$PRETTIER_FILES" | xargs git add
    else
        echo "pre-commit: $PRETTIER not found, not formatting; run heatflask-setup"
    fi
fi

if [ -n "$RUFF_FILES" ]; then
    if command -v ruff >/dev/null 2>&1; then
        # Format, then apply the lint fixes Ruff considers safe. --exit-zero
        # because this hook formats, it does not gate: anything left over is
        # reported here and enforced in CI, rather than blocking the commit.
        echo "$RUFF_FILES" | xargs ruff format --quiet
        echo "$RUFF_FILES" | xargs ruff check --fix-only --quiet

        # Add back the modified files to staging
        echo "$RUFF_FILES" | xargs git add

        # Report, without failing, whatever could not be fixed automatically.
        echo "$RUFF_FILES" | xargs ruff check --quiet --exit-zero
    else
        echo "pre-commit: ruff not found, not formatting; run inside 'nix develop'"
    fi
fi

exit 0
