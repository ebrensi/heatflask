#!usr/bin/env sh

### 🔥 Do not edit this file if it is called .env.tmp 🔥
### instead,
###  Copy this file to ".env" (or let ./dev-install-backend do it for you)
### and edit .env

# This file should only exist on a develper's local machine because it contains private info.
#  Please do not remove .env from .gitignore

# Activate Python virtual-environment with packages from requirements.txt
#  If you installed the backend with dev-install then the environment should
#  already be set up
source ./.venv/heatflask/bin/activate

# *************************************************************************
#  heatflask app expects the following variables to be in the environment
#

# MongoDB is the only datastore. Redis and Postgres are gone.
# (This used to say MONGODB_URI, which the app never read.)
export MONGODB_URL="mongodb://localhost:27017/heatflask"

# These are the Strava credentials you will need to acces Strava data
# see https://developers.strava.com/docs for instructions.
export STRAVA_CLIENT_ID="....your client-id goes here..."
export STRAVA_CLIENT_SECRET="...your client-secret goes here..."

export APP_ENV=development

# Required when APP_ENV is not development; the app refuses to start without
# them. In development they are optional.
#
# SESSION_SECRET signs the session cookie. Any long random string, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it logs everyone out.
# export SESSION_SECRET="..."
#
# SERVER_NAME is the public address, scheme included. Strava's OAuth redirect
# and the webhook callback are built from it, so its domain must be the one
# registered as the app's Authorization Callback Domain on Strava.
# export SERVER_NAME="https://www.heatflask.com"

# Only needed to run the one-shot legacy user import (Users.migrate()),
# which also needs `pip install -r requirements-migrate.txt`
# export LEGACY_POSTGRES_URL="postgres://..."

# ***************************************************************************
