# Local settings for the backend. Copy this file to backend/.env and fill it in;
# heatflask-run loads backend/.env if it exists. backend/.env holds your Strava
# client secret, so it is gitignored and must never be committed.

# These are the Strava credentials you will need to access Strava data.
# See https://developers.strava.com/docs/getting-started/ for how to get them.
export STRAVA_CLIENT_ID="...your client-id goes here..."
export STRAVA_CLIENT_SECRET="...your client-secret goes here..."

# heatflask-run defaults to these two, so they only need setting to change them.
# export MONGODB_URL="mongodb://localhost:27017/heatflask"
# export APP_ENV=development

# Required when APP_ENV is not development; the app refuses to start without
# them. In development they are optional.
#
# SESSION_SECRET signs the session cookie. Any long random string, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it logs everyone out.
# export SESSION_SECRET="..."
#
# SERVER_NAME is the public address, scheme included. Strava's OAuth redirect
# and the webhook callback are built from it, so its domain must be the one
# registered as the app's Authorization Callback Domain on Strava.
# export SERVER_NAME="https://www.heatflask.com"

# Development switches. These are better given for one run than left in here,
# e.g. `HEATFLASK_RESET=1 heatflask-run`.
#
# OFFLINE=1 serves only the activity streams already in Mongo, and fetches
# none from Strava.
# HEATFLASK_RESET=1 drops the users, index and streams collections, then stops
# the server instead of serving.
# export OFFLINE=1
# export HEATFLASK_RESET=1
